# Server
PORT=3000
MONGODB_URI=mongodb://localhost:27017/market-service
REDIS_URL=redis://localhost:6379

# AuthService — RS256 public key fetched once at startup from AUTH_SERVICE_URL/jwt/public-key
AUTH_SERVICE_URL=https://auth.freischule.info
# Optional: skip the network round-trip (used in tests/CI) and use this PEM directly instead
AUTH_JWT_PUBLIC_KEY=

# Internal service-to-service auth — one key per caller, never a shared master key
INTERNAL_API_KEY_PAYMENT_SERVICE=
INTERNAL_API_KEY_WAVE_SERVICE=

# PaymentService — checkout sessions + refunds
PAYMENT_SERVICE_URL=https://payment.freischule.info
PAYMENT_SERVICE_API_KEY=
# Platform fee passed as feeCents on each checkout session (PaymentService requires it
# explicitly); implementation-only default, not part of the documented API contract.
PLATFORM_FEE_BPS=500

# EmailService — order confirmation mail
EMAIL_SERVICE_URL=https://email.freischule.info
EMAIL_SERVICE_API_KEY=

# WaveService — stats update for wave-coupled drops
WAVE_SERVICE_URL=https://wave.freischule.info
WAVE_SERVICE_API_KEY=

# ExceptionService — unhandled error reporting
EXCEPTION_SERVICE_URL=https://exception.freischule.info
EXCEPTION_SERVICE_API_KEY=

# Minutes a pendingPayment hold reserves stock before the cron releases it
ORDER_HOLD_TTL_MIN=5

# Used to build PaymentService success/cancel redirect URLs
APP_BASE_URL=https://app.wavymania.io
